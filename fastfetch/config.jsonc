{
  "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
  "logo": null,
  "display": {
    "separator": "  ",
    "color": "white",
    "constants": ["", "", "", ""]
  },
  "modules": [
    "break",
    {
      "type": "custom",
      "key": "╭───────────────────────────────────╮",
      "outputColor": "#D8A8D0"
    },
    {
      "type": "kernel",
      "key": "│   kernel",
      "format": "{release>22} │",
      "keyColor": "#FF8FAB",
      "outputColor": "#F5DCE9"
    },
    {
      "type": "command",
      "key": "│   uptime",
      "text": "uptime -p | cut -d ' ' -f 2-",
      "format": "{>22} │",
      "keyColor": "#FF8FAB",
      "outputColor": "#F5DCE9"
    },
    {
      "type": "shell",
      "key": "│   shell ",
      "format": "{pretty-name>22} │",
      "keyColor": "#FF8FAB",
      "outputColor": "#F5DCE9"
    },
    {
      "type": "command",
      "key": "│   mem   ",
      "text": "free -m | awk 'NR==2{printf \"%.2f GiB / %.2f GiB\",$3/1024,$2/1024}'",
      "format": "{>22} │",
      "keyColor": "#FF8FAB",
      "outputColor": "#F5DCE9"
    },
    {
      "type": "packages",
      "key": "│   pkgs  ",
      "format": "{all>22} │",
      "keyColor": "#FF8FAB",
      "outputColor": "#F5DCE9"
    },
    {
      "type": "command",
      "key": "│   user  ",
      "text": "echo $USER",
      "format": "{>22} │",
      "keyColor": "#FF8FAB",
      "outputColor": "#F5DCE9"
    },
    {
      "type": "command",
      "key": "│   hname",
      "text": "hostnamectl hostname",
      "format": "{>22} │",
      "keyColor": "#FF8FAB",
      "outputColor": "#F5DCE9"
    },
    {
      "type": "os",
      "key": "│ 󰻀  distro",
      "format": "{pretty-name>22} │",
      "keyColor": "#FF8FAB",
      "outputColor": "#F5DCE9"
    },
    {
      "type": "custom",
      "key": "╰───────────────────────────────────╯",
      "outputColor": "#D8A8D0"
    },
    "break"
  ]
}
