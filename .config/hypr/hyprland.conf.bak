bind = SUPER, Space, exec, ~/.local/bin/wofi-cute






bind = SUPER, T, exec, foot

# === Caelestia-style keybinds ===

# Workspaces
bind = SUPER, 1, workspace, 1
bind = SUPER, 2, workspace, 2
bind = SUPER, 3, workspace, 3
bind = SUPER, 4, workspace, 4
bind = SUPER, 5, workspace, 5
bind = SUPER, 6, workspace, 6
bind = SUPER, 7, workspace, 7
bind = SUPER, 8, workspace, 8
bind = SUPER, 9, workspace, 9
bind = SUPER, 0, workspace, 10

bind = SUPER ALT, 1, movetoworkspace, 1
bind = SUPER ALT, 2, movetoworkspace, 2
bind = SUPER ALT, 3, movetoworkspace, 3
bind = SUPER ALT, 4, movetoworkspace, 4
bind = SUPER ALT, 5, movetoworkspace, 5
bind = SUPER ALT, 6, movetoworkspace, 6
bind = SUPER ALT, 7, movetoworkspace, 7
bind = SUPER ALT, 8, movetoworkspace, 8
bind = SUPER ALT, 9, movetoworkspace, 9
bind = SUPER ALT, 0, movetoworkspace, 10

# Previous / next workspace
bind = SUPER SHIFT CTRL, right, movetoworkspace, +1
bind = SUPER SHIFT CTRL, left, movetoworkspace, -1
bind = SUPER SHIFT, right, workspace, +1
bind = SUPER SHIFT, left, workspace, -1
bind = SUPER, mouse_down, workspace, +1
bind = SUPER, mouse_up, workspace, -1
bind = SUPER, Page_Down, workspace, +1
bind = SUPER, Page_Up, workspace, -1

# Window focus
bind = SUPER, left, movefocus, l
bind = SUPER, right, movefocus, r
bind = SUPER, up, movefocus, u
bind = SUPER, down, movefocus, d

# Move windows
bind = SUPER SHIFT, left, movewindow, l
bind = SUPER SHIFT, right, movewindow, r
bind = SUPER SHIFT, up, movewindow, u
bind = SUPER SHIFT, down, movewindow, d

# Window actions
bindm = SUPER, mouse:272, movewindow
bind = SUPER, Q, killactive
bind = SUPER, F, fullscreen
bind = SUPER ALT, F, fullscreenstate, 2 2
bind = SUPER ALT, Space, togglefloating
bind = SUPER, P, pin

# Resize
binde = SUPER, Minus, resizeactive, -50 0
binde = SUPER, Equal, resizeactive, 50 0
binde = SUPER SHIFT, Minus, resizeactive, 0 -50
binde = SUPER SHIFT, Equal, resizeactive, 0 50

# Groups
bind = ALT, Tab, changegroupactive, f
bind = SHIFT ALT, Tab, changegroupactive, b
bind = SUPER, Comma, togglegroup
bind = SUPER, U, moveoutofgroup

# Terminal

# Media
bind = CTRL SUPER, Space, exec, playerctl play-pause
bind = CTRL SUPER, Equal, exec, playerctl next
bind = CTRL SUPER, Minus, exec, playerctl previous
bind = CTRL SUPER, Backspace, exec, playerctl stop
bind = SUPER SHIFT, M, exec, wpctl set-mute @DEFAULT_AUDIO_SINK@ toggle


# Brightness

input {
    touchpad {
        disable_while_typing = false
    }
}

decoration {
    rounding = 16
}
bind = , XF86AudioMute, exec, wpctl set-mute @DEFAULT_AUDIO_SINK@ toggle
binde = , XF86AudioLowerVolume, exec, wpctl set-volume @DEFAULT_AUDIO_SINK@ 5%-
binde = , XF86AudioRaiseVolume, exec, wpctl set-volume -l 1.0 @DEFAULT_AUDIO_SINK@ 5%+
general {
    col.active_border = rgb(E69BD0)
    col.inactive_border = rgb(8F5C80)
}
bind = SUPER, E, exec, dolphin
bind = SUPER, W, exec, firefox
bind = SUPER, L, exec, hyprctl dispatch exit
binde = , XF86MonBrightnessDown, exec, brightnessctl set 5%-
binde = , XF86MonBrightnessUp, exec, brightnessctl set 5%+

general {
    gaps_in = 4
    gaps_out = 4
}
bind = , XF86AudioMicMute, exec, wpctl set-mute @DEFAULT_AUDIO_SOURCE@ toggle
bind = SUPER, N, exec, ~/.local/bin/toggle-wifi-app
exec-once = ~/.local/bin/start-wallpaper
exec-once = ~/.local/bin/start-audio
exec-once = qs -c volume-osd
exec-once = qs -c brightness-osd
exec-once = qs -c mic-osd
exec-once = qs -c topbar
